# ============================================================
# .env.production — قيم الإنتاج الفعلية
# لا ترفع هذا الملف على GitHub أبداً (.gitignore بيحميه بالفعل)
# ============================================================

# نفس secret key المحلي شغال، أو ولّد واحد جديد بالأمر:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=j0Hk2cdn85sNIEloqhouDwV2HV_droi!8TTN!3db++*e+Q4asMWy)8^#zMyO

DJANGO_DEBUG=False

# --- غيّر السطرين دول لدومينك الفعلي بعد ما ياخده Railway/Render ---
DJANGO_ALLOWED_HOSTS=your-app-name.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-app-name.up.railway.app

DJANGO_ADMIN_URL=atelier-command-x92f/

# --- قاعدة البيانات ---
# لا تلمس هذا القسم: لما تربط Postgres على Railway/Render، هم بيضيفوا
# متغير DATABASE_URL تلقائياً في إعدادات البيئة عندهم، والمشروع هيكتشفه
# ويستخدمه لوحده (شوف config/settings.py). مفيش حاجة تعملها هنا يدوياً.

# --- البريد (اختياري - لو عايز إشعارات بالطلبات الجديدة) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=
