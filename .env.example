# Copy this file to ".env" and fill in real values. NEVER commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=codeforge.example.com,www.codeforge.example.com

# Secret, non-default admin URL path (include the trailing slash).
DJANGO_ADMIN_URL=atelier-command-x92f/

CSRF_TRUSTED_ORIGINS=https://codeforge.example.com

# Database (defaults to sqlite3 if left blank)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=codeforge
DB_USER=codeforge_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Email (used to notify the admin of new service requests)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@codeforge.example.com
EMAIL_HOST_PASSWORD=change-me
ADMIN_NOTIFICATION_EMAIL=admin@codeforge.example.com
